[Unit]
Description=Telegram Spy Game Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-bot
Group=telegram-bot
Environment="SHPIGON_TOKEN=replace-with-your-telegram-bot-token"
Environment="SHPIGON_LANGUAGE=en"
WorkingDirectory=/opt/telegram-shpigon-game-bot
ExecStart=/usr/bin/dotnet /opt/telegram-shpigon-game-bot/telegramShpigonGameBot.dll
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
